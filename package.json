{
  "name": "aetherweaver",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Aetherweaver — a support-focused action roguelite. Remake of the original prototype (see docs/plan).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.sim.json && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "sim:bench": "tsx tools/sim-bench.ts",
    "sim:replay": "tsx tools/replay-verify.ts",
    "golden:update": "tsx tools/update-golden.ts --write",
    "harness": "tsx tools/harness.ts",
    "loadouts": "tsx tools/loadouts.ts",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build && npm run e2e"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
